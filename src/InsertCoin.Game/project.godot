; Engine configuration file.
config_version=5

[application]

config/name="INSERT COIN"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#")
run/low_processor_mode=true
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[display]

window/size/viewport_width=647
window/size/viewport_height=820
window/size/window_width_override=518
window/size/window_height_override=656
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=false
window/per_pixel_transparency/allowed=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/subwindows/embed_subwindows=false

[dotnet]

project/assembly_name="InsertCoin.Game"

[internationalization]

locale/include_text_server_data=true

[rendering]

renderer/rendering_method="gl_compatibility"
viewport/transparent_background=true
viewport/hdr_2d=true

[editor_plugins]

enabled=PackedStringArray("res://addons/Godot-MToon-Shader/plugin.cfg", "res://addons/vrm/plugin.cfg")

[audio]

driver/enable_input=true
